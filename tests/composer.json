{
  "name": "panto/module-source-tests",
  "description": "Standalone PHPUnit runner for Panto_Source (no full Magento install required for unit tests).",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "~8.4.0||~8.5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit -c phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {},
    "preferred-install": "dist"
  }
}
