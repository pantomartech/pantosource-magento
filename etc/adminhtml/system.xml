<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="pantosource" translate="label" sortOrder="400">
            <label>PantoSource</label>
        </tab>
        <section id="pantosource" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Settings</label>
            <tab>pantosource</tab>
            <resource>Panto_Source::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Module</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="ingestion" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>API Key</label>
                <field id="api_key" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
            </group>
            <group id="tracking" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Advanced settings</label>
                <field id="frontend_tracker" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Frontend Tracker</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="attribution" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Attribution Enrichment</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="attribution_lookback_days" translate="label" type="text" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Attribution Lookback (days)</label>
                    <comment>Default 30. Cookie window for first/last touch persistence.</comment>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="spa_pageviews" translate="label" type="select" sortOrder="28" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable SPA Pageviews</label>
                    <comment>Track history.pushState / popstate route changes as pageviews.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="hashed_pii" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Hashed PII</label>
                    <comment>When enabled, SHA-256 identifiers are added on events that carry customer email or profile (not only orders). Default is off; plaintext profile is still sent so ad platforms can hash at publish time.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="debug_mode" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Debug Mode (admin timeline)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="consent_mode" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Consent Mode</label>
                    <source_model>Panto\Source\Model\Config\Source\ConsentMode</source_model>
                </field>
                <field id="portal_base_url" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Portal base URL</label>
                    <comment>Used for order snapshot export to Panto store health (no trailing slash). Default https://app.pantosource.com</comment>
                    <config_path>pantosource/portal/base_url</config_path>
                </field>
                <field id="ingestion_base_url" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Ingestion Base URL</label>
                    <comment>Default https://events.pantosource.com (no trailing slash). Leave as-is unless you use a custom ingestion endpoint.</comment>
                    <config_path>pantosource/ingestion/base_url</config_path>
                </field>
            </group>
        </section>
    </system>
</config>
