<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="pantosource.head.marker"
                   template="Panto_Source::head-marker.phtml"
                   cacheable="true"/>
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block class="Panto\Source\Block\Tracker"
                   name="pantosource.tracker"
                   template="Panto_Source::tracker.phtml"
                   cacheable="true"
                   ifconfig="pantosource/tracking/frontend_tracker"/>
        </referenceContainer>
    </body>
</page>
